# Every value here is optional. Each missing key disables one feature; none of
# them break the build. See README.md for what is lost in each case.

# Shopify Storefront API — without these the catalogue still renders from
# src/lib/catalog and checkout is disabled.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_STOREFRONT_API_VERSION=

# Apple Pay on the product page. Without these the button never renders and
# the Reserve path is unchanged. All four are needed together, and they come
# from two places: Apple issues the identifier, certificate and association
# text, while the Storefront token above must additionally carry the
# `write_cart_wallet_payments` scope, which is gated and requested from
# Shopify. The cert and key are PEM, newlines and all.
APPLE_PAY_MERCHANT_ID=
APPLE_PAY_MERCHANT_CERT=
APPLE_PAY_MERCHANT_KEY=
APPLE_PAY_DOMAIN_ASSOCIATION=

# Concierge. Retrieval runs with or without this; the model is only ever
# allowed to rephrase a retrieved answer, never to add facts of its own.
OPENAI_API_KEY=
OPENAI_MODEL=

# Where private-client and appointment requests are forwarded. With no
# destination the forms say plainly that they are not yet connected rather
# than pretending to have captured an address.
CLIENT_REGISTER_WEBHOOK_URL=
CLIENT_REGISTER_WEBHOOK_TOKEN=

# Canonical origin, used for metadata, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://tamiale.com
